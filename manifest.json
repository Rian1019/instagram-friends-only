{
  "manifest_version": 3,
  "name": "Instagram Friends Only",
  "version": "0.3.0",
  "description": "Keep messages, followed posts, and stories while hiding Instagram recommendations, Reels, and Explore.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://www.instagram.com/*"],
  "action": {
    "default_title": "Instagram Friends Only",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
